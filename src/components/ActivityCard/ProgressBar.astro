---
interface Props {
  raised: number;
  cost: number;
}

const { raised, cost } = Astro.props;
const percent = Math.min(100, Math.round((raised / cost) * 100));
---

<div class="flex flex-col gap-1">
  <div
    class="bg-canvas border-primary--alt h-3 w-full overflow-hidden rounded-full border"
  >
    <div
      class="bg-secondary--alt h-full rounded-full transition-[width] duration-500"
      style={`width: ${percent}%`}
      data-progress-fill
    >
    </div>
  </div>
  <p class="flex items-baseline gap-1 p-0">
    <span class="text-secondary text-xl font-bold" data-progress-current>
      £{raised}
    </span>
    <span class="text-sm">of £{cost}</span>
  </p>
</div>
