    cost: 200,
    raised: 0,
  },
  {
    id: "rum",
    title: "Rum tasting",
    description: "Private tour and tasting at a local rum distillery",
    imgSrc:
      "https://www.rhumeriedechamarel.com/wp-content/uploads/2023/03/291419687_10159633338707247_408804649930069778_n.jpg",
    link: "https://www.rhumeriedechamarel.com/en/la-visite-guidee/",
    cost: 50,
    raised: 0,
  },
  {
    id: "zipline",
    title: "Ziplining",
    description:
      "Fly through the treetops with Vallé's Zipline Adventures — a high-speed journey over valleys, rivers, and forest canopies.",
    imgSrc: "https://vallepark.com/wp-content/uploads/2022/09/Zipline5.avif",
    link: "https://vallepark.com/adventure-activities/zipline/",
    cost: 150,
    raised: 0,
  },
